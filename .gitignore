# Python environments (setup.sh recreates them)
.venv*/
__pycache__/
*.pyc

# Third-party files: Tesla's repo (lightshow/tesla_files.py), the viewer's car models from the Tesla
# app (lightshow/tesla_app_models.py), and
# local study material: none of it is ours to redistribute
vendor/
preview3d/public/models/
preview3d/dist/models/

# Recordings: bring your own (songs/README.md); they're never committed
songs/*
!songs/README.md

# Voice tracks for diagnostic shows of other lineups (build.py --diagnostic)
cache/

# Generated from songs/ by build.py (--assemble regenerates them in a minute)
output/**/*.wav
output/**/stems/
usb/

# Analysis caches and logs (rebuilt by build.py)
output/**/*.pkl
output/**/*.npy
output/**/*.json
output/**/build.log
output/.demucs.lock
output/**/*.mp4

# The web app's uploads and results (deleted after a day anyway)
webapp/jobs/

# Review images, viewer dependencies
checks/
preview3d/node_modules/

.DS_Store
