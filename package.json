{
  "name": "carreography",
  "private": true,
  "version": "0.1.0",
  "description": "Synchronized Tesla light shows for 1-5 cars from any song, made in your browser, with a 3D preview.",
  "keywords": [
    "tesla",
    "light-show",
    "fseq",
    "cybertruck",
    "model-y",
    "music-visualization",
    "beat-tracking",
    "onnxruntime-web",
    "threejs"
  ],
  "homepage": "https://matthewhager.github.io/carreography/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewHager/carreography.git"
  },
  "bugs": {
    "url": "https://github.com/MatthewHager/carreography/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint src tools",
    "preview": "vite preview",
    "review": "node tools/review/review.mjs",
    "check": "tsc -b && tsc -p tools/review && oxlint src tools && vitest run",
    "assets": "node tools/assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "onnxruntime-web": "^1.31.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
